# Image Docker avec CWB pour Kubuntu 26.04+
FROM ubuntu:20.04

# Éviter les prompts interactifs
ENV DEBIAN_FRONTEND=noninteractive

# Installer les dépendances de build et CWB
RUN apt-get update && apt-get install -y \
    build-essential \
    libpcre3-dev \
    libglib2.0-dev \
    libreadline-dev \
    libncurses-dev \
    bison \
    flex \
    wget \
    perl \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Télécharger et compiler CWB
RUN cd /tmp && \
    wget https://sourceforge.net/projects/cwb/files/cwb/cwb-3.5/source/cwb-3.5.0-src.tar.gz/download -O cwb-3.5.0-src.tar.gz && \
    tar xzf cwb-3.5.0-src.tar.gz && \
    cd cwb-3.5.0-src && \
    ./install-scripts/install-linux && \
    cd / && \
    rm -rf /tmp/cwb*

# Variables d'environnement pour CWB
ENV PATH="/usr/local/bin:${PATH}"
ENV CORPUS_REGISTRY="/usr/local/share/cwb/registry"

# Créer le répertoire de travail
WORKDIR /workspace

# Point d'entrée par défaut
CMD ["bash"]
